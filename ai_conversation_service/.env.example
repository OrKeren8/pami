# AI Conversation Service Configuration

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI Organization and Project (leave empty if not needed)
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_existing_s3_bucket_name_here

# Service Configuration
SERVICE_NAME=ai-conversation-service
DEBUG=true

# Projects service URL (used to enrich chat context with project name/goal)
# Example local: http://localhost:8000
# Example gateway: https://<api-host>
PROJECTS_API_URL=

# Logging
LOG_LEVEL=INFO